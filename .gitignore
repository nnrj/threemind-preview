test-artifacts/
*.tmp
*.temp
*.bak
*.orig
*.rej

# Editor and operating-system metadata.
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini

# Second-generation local services and Rust products.
.work/
target/
OLD/
deploy/*.env
deploy/runtime-input/
deploy/runtime-output/

