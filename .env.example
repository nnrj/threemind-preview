# Run `threemind setup-local` to create an isolated workstation database.
# Or configure an existing, dedicated database with a non-owner application role.
THREEMIND_MODE=workstation
# Lab login is enabled by default, including on localhost. Set the first password
# in the browser setup page; CLI/Agent credentials are separate from browser cookies.
THREEMIND_AUTHENTICATION=session
# Explicit local mode is only for a trusted loopback workstation, never a server.
# Non-interactive clients may use a protected saved profile or a bounded API token.
# THREEMIND_AUTH_PROFILE=default
# THREEMIND_AUTH_DIR=
# THREEMIND_API_TOKEN=
# THREEMIND_EXECUTION_SOURCE=ai
# First-time setup: fill these locally, then run threemind setup-local.
THREEMIND_PG_ADMIN_HOST=127.0.0.1
THREEMIND_PG_ADMIN_PORT=5433
THREEMIND_PG_ADMIN_DATABASE=postgres
THREEMIND_PG_ADMIN_USER=postgres
THREEMIND_PG_ADMIN_PASSWORD=
# setup-local writes dedicated application and migration URLs automatically.
THREEMIND_BACKEND=native
THREEMIND_HOSTS=127.0.0.1,localhost
THREEMIND_ORIGINS=http://127.0.0.1:8877,http://localhost:8877,http://127.0.0.1:3001,http://localhost:3001
THREEMIND_SECURE_COOKIE=false
THREEMIND_MAX_ACTIVE_JOBS=2
# Workstation creates a key automatically. Never commit a real key.
# Server API/AI workers share the key. Rotation: new key first, then old keys.
THREEMIND_SECRET_KEYS=
THREEMIND_MAX_AI_JOBS=2
THREEMIND_MAX_NOTIFICATION_JOBS=1
# Server deployments explicitly allow email service host:port endpoints.
THREEMIND_NOTIFICATION_ALLOWED_ENDPOINTS=
# Server only: exact trusted provider and proxy origins, comma-separated.
THREEMIND_AI_ALLOWED_ORIGINS=
THREEMIND_MAX_IMPORT_MB=128
THREEMIND_MAX_MEDIA_DECODERS=2
THREEMIND_MAX_MEDIA_UPLOADS=4
THREEMIND_MAX_STAGED_MEDIA_MB=16384
